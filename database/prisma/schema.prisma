// LUXE VASTRA Digital Platform - Database Schema
// PostgreSQL 18.x with Prisma ORM 6.x
// Conforms to LVF-SSOT-001 Section 12

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// 1. Identity & Access Management (MOD-IAM)
// -------------------------------------------------------------

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique @db.VarChar(254)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  firstName    String?    @map("first_name") @db.VarChar(100)
  lastName     String?    @map("last_name") @db.VarChar(100)
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  roles        UserRole[]
  customer     Customer?

  @@map("users")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(50)
  name        String           @db.VarChar(100)
  description String?          @db.VarChar(255)
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model UserRole {
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(100)
  module      String           @db.VarChar(50)
  description String?          @db.VarChar(255)

  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// -------------------------------------------------------------
// 2. Customer, Address & CRM Profile (MOD-CRM / MOD-ECOM)
// -------------------------------------------------------------

model Customer {
  id                    String            @id @default(uuid()) @db.Uuid
  userId                String?           @unique @map("user_id") @db.Uuid
  name                  String            @db.VarChar(120)
  email                 String            @unique @db.VarChar(254)
  phone                 String?           @db.VarChar(50)
  vipLevel              String?           @map("vip_level") @db.VarChar(50)
  relationshipManagerId String?           @map("relationship_manager_id") @db.Uuid
  notes                 String?           @db.VarChar(2000)
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamptz

  user                  User?             @relation(fields: [userId], references: [id])
  addresses             CustomerAddress[]
  orders                Order[]
  cart                  Cart?
  wishlistItems         WishlistItem[]
  visits                ShowroomVisit[]
  guestRegistrations    EventGuest[]

  @@map("customers")
}

model CustomerAddress {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  name       String   @db.VarChar(120)
  phone      String   @db.VarChar(50)
  line1      String   @db.VarChar(200)
  line2      String?  @db.VarChar(200)
  city       String   @db.VarChar(100)
  region     String   @db.VarChar(100)
  postalCode String   @map("postal_code") @db.VarChar(50)
  country    String   @db.VarChar(100)
  isDefault  Boolean  @default(false) @map("is_default")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@map("customer_addresses")
}

// -------------------------------------------------------------
// 3. Catalogue & Products (MOD-CAT)
// -------------------------------------------------------------

model Category {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @db.VarChar(100)
  slug        String    @unique @db.VarChar(120)
  description String?   @db.VarChar(1000)
  parentId    String?   @map("parent_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]

  @@map("categories")
}

model Product {
  id               String           @id @default(uuid()) @db.Uuid
  categoryId       String           @map("category_id") @db.Uuid
  name             String           @db.VarChar(200)
  sku              String           @unique @db.VarChar(40)
  price            Decimal          @db.Decimal(12, 2)
  status           String           @default("inactive") @db.VarChar(20) // active, inactive
  description      String?          @db.VarChar(5000)
  fabricText       String?          @map("fabric_text") @db.VarChar(5000)
  careInstructions String?          @map("care_instructions") @db.VarChar(5000)
  createdBy        String?          @map("created_by") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  category         Category         @relation(fields: [categoryId], references: [id])
  variants         ProductVariant[]
  images           ProductImage[]
  fashionLink      FashionLink?
  wishlistItems    WishlistItem[]

  @@index([sku, name])
  @@map("products")
}

model ProductVariant {
  id         String     @id @default(uuid()) @db.Uuid
  productId  String     @map("product_id") @db.Uuid
  sku        String     @unique @db.VarChar(60)
  size       String?    @db.VarChar(20)
  colour     String?    @db.VarChar(50)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory  Inventory[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@map("product_variants")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  url       String   @db.VarChar(1000)
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

// -------------------------------------------------------------
// 4. Design Collections & Connect Fashions (MOD-COL / MOD-CONNECT)
// -------------------------------------------------------------

model Collection {
  id          String        @id @default(uuid()) @db.Uuid
  name        String        @db.VarChar(200)
  season      String        @db.VarChar(50)
  status      String        @default("MOODBOARD") @db.VarChar(30) // MOODBOARD, IN_DESIGN, REVIEW, APPROVED, PRODUCTION, LIVE, ARCHIVED
  description String?       @db.VarChar(5000)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  fashionLinks FashionLink[]

  @@map("collections")
}

model FashionLink {
  id                String           @id @default(uuid()) @db.Uuid
  collectionId      String           @map("collection_id") @db.Uuid
  productId         String?          @unique @map("product_id") @db.Uuid
  fabricBatchId     String?          @map("fabric_batch_id") @db.Uuid
  productionOrderId String?          @map("production_order_id") @db.Uuid
  ecommerceVisible  Boolean          @default(false) @map("ecommerce_visible")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  collection        Collection       @relation(fields: [collectionId], references: [id])
  product           Product?         @relation(fields: [productId], references: [id])
  fabricBatch       FabricBatch?     @relation(fields: [fabricBatchId], references: [id])
  productionOrder   ProductionOrder? @relation(fields: [productionOrderId], references: [id])
  eventLooks        EventLook[]

  @@map("fashion_links")
}

// -------------------------------------------------------------
// 5. Textile & Garment Production (MOD-TEX / MOD-PRD)
// -------------------------------------------------------------

model FabricBatch {
  id           String        @id @default(uuid()) @db.Uuid
  code         String        @unique @db.VarChar(50)
  batchNumber  String        @map("batch_number") @db.VarChar(50)
  fabricType   String        @map("fabric_type") @db.VarChar(100)
  supplier     String        @db.VarChar(150)
  quantity     Decimal       @db.Decimal(12, 2)
  unit         String        @db.VarChar(20)
  colour       String        @db.VarChar(50)
  status       String        @default("RECEIVED") @db.VarChar(30)
  warehouseId  String?       @map("warehouse_id") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  warehouse    Warehouse?    @relation(fields: [warehouseId], references: [id])
  fashionLinks FashionLink[]

  @@map("fabric_batches")
}

model ProductionOrder {
  id             String           @id @default(uuid()) @db.Uuid
  orderNumber    String           @unique @map("order_number") @db.VarChar(50)
  status         String           @default("PLANNED") @db.VarChar(30) // PLANNED, CUTTING, STITCHING, EMBROIDERY, QC, FINISHING, PACKED, COMPLETED, CANCELLED
  targetQuantity Int              @map("target_quantity")
  startedAt      DateTime?        @map("started_at") @db.Timestamptz
  completedAt    DateTime?        @map("completed_at") @db.Timestamptz
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  steps          ProductionStep[]
  inspections    QualityInspection[]
  fashionLinks   FashionLink[]

  @@map("production_orders")
}

model ProductionStep {
  id                String          @id @default(uuid()) @db.Uuid
  productionOrderId String          @map("production_order_id") @db.Uuid
  stepName          String          @map("step_name") @db.VarChar(50)
  status            String          @db.VarChar(30)
  notes             String?         @db.VarChar(1000)
  completedBy       String?         @map("completed_by") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz

  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)

  @@map("production_steps")
}

// -------------------------------------------------------------
// 6. Quality Control (MOD-QC)
// -------------------------------------------------------------

model QualityInspection {
  id                String           @id @default(uuid()) @db.Uuid
  inspectionRef     String           @unique @map("inspection_ref") @db.VarChar(50) // e.g. QC-00045
  productionOrderId String?          @map("production_order_id") @db.Uuid
  inspectorId       String           @map("inspector_id") @db.Uuid
  measurementCheck  String           @map("measurement_check") @db.VarChar(10) // PASS / FAIL
  colourCheck       String           @map("colour_check") @db.VarChar(10)
  strengthCheck     String           @map("strength_check") @db.VarChar(10)
  shrinkageCheck    String           @map("shrinkage_check") @db.VarChar(10)
  needleCheck       String           @map("needle_check") @db.VarChar(10)
  finishCheck       String           @map("finish_check") @db.VarChar(10)
  packagingCheck    String           @map("packaging_check") @db.VarChar(10)
  decision          String           @db.VarChar(20) // APPROVED / REJECTED
  notes             String?          @db.VarChar(2000)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz

  productionOrder   ProductionOrder? @relation(fields: [productionOrderId], references: [id])

  @@map("quality_inspections")
}

// -------------------------------------------------------------
// 7. Inventory & Showroom Warehouses (MOD-INV / MOD-STORE)
// -------------------------------------------------------------

model Warehouse {
  id             String                 @id @default(uuid()) @db.Uuid
  code           String                 @unique @db.VarChar(30)
  name           String                 @db.VarChar(160)
  type           String                 @default("WAREHOUSE") @db.VarChar(30) // WAREHOUSE, SHOWROOM
  address        String                 @db.VarChar(500)
  isFulfillment  Boolean                @default(false) @map("is_fulfillment")
  status         String                 @default("active") @db.VarChar(20) // active, inactive
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamptz

  inventory      Inventory[]
  transactions   InventoryTransaction[]
  fabricBatches  FabricBatch[]
  visits         ShowroomVisit[]
  orders         Order[]

  @@map("warehouses")
}

model Inventory {
  id                 String         @id @default(uuid()) @db.Uuid
  variantId          String         @map("variant_id") @db.Uuid
  warehouseId        String         @map("warehouse_id") @db.Uuid
  onHand             Decimal        @default(0) @map("on_hand") @db.Decimal(12, 2)
  reserved           Decimal        @default(0) @db.Decimal(12, 2)
  lowStockThreshold  Decimal        @default(5) @map("low_stock_threshold") @db.Decimal(12, 2)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  variant            ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse          Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([variantId, warehouseId])
  @@map("inventory")
}

model InventoryTransaction {
  id            String    @id @default(uuid()) @db.Uuid
  variantId     String    @map("variant_id") @db.Uuid
  warehouseId   String    @map("warehouse_id") @db.Uuid
  quantityDelta Decimal   @map("quantity_delta") @db.Decimal(12, 2)
  balanceAfter  Decimal   @map("balance_after") @db.Decimal(12, 2)
  reason        String    @db.VarChar(50) // receipt, order, transfer, adjustment, release
  referenceId   String    @map("reference_id") @db.Uuid
  createdBy     String?   @map("created_by") @db.Uuid
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz

  warehouse     Warehouse @relation(fields: [warehouseId], references: [id])

  @@map("inventory_transactions")
}

model ShowroomVisit {
  id              String    @id @default(uuid()) @db.Uuid
  customerId      String    @map("customer_id") @db.Uuid
  showroomId      String    @map("showroom_id") @db.Uuid
  startsAt        DateTime  @map("starts_at") @db.Timestamptz
  attended        Boolean   @default(false)
  notes           String?   @db.VarChar(2000)
  preferredSize   String?   @map("preferred_size") @db.VarChar(20)
  preferredColour String?   @map("preferred_colour") @db.VarChar(50)
  staffId         String?   @map("staff_id") @db.Uuid
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  customer        Customer  @relation(fields: [customerId], references: [id])
  showroom        Warehouse @relation(fields: [showroomId], references: [id])

  @@map("showroom_visits")
}

// -------------------------------------------------------------
// 8. Cart, Wishlist, Orders & Payments (MOD-ECOM / MOD-STORE)
// -------------------------------------------------------------

model Cart {
  id         String     @id @default(uuid()) @db.Uuid
  customerId String     @unique @map("customer_id") @db.Uuid
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  customer   Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items      CartItem[]

  @@map("carts")
}

model CartItem {
  id        String         @id @default(uuid()) @db.Uuid
  cartId    String         @map("cart_id") @db.Uuid
  variantId String         @map("variant_id") @db.Uuid
  quantity  Int            @default(1)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@unique([cartId, variantId])
  @@map("cart_items")
}

model WishlistItem {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([customerId, productId])
  @@map("wishlists")
}

model Order {
  id                String           @id @default(uuid()) @db.Uuid
  orderNumber       String           @unique @map("order_number") @db.VarChar(50)
  customerId        String           @map("customer_id") @db.Uuid
  channel           String           @default("WEBSITE") @db.VarChar(30) // WEBSITE, SHOWROOM
  status            String           @default("PENDING") @db.VarChar(30) // PENDING, CONFIRMED, PROCESSING, PRODUCTION, READY, PACKED, SHIPPED, DELIVERED, RETURN_REQUESTED, RETURNED, CANCELLED
  totalAmount       Decimal          @map("total_amount") @db.Decimal(12, 2)
  currency          String           @default("INR") @db.VarChar(10)
  shippingAddressId String?          @map("shipping_address_id") @db.Uuid
  showroomId        String?          @map("showroom_id") @db.Uuid
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  customer          Customer         @relation(fields: [customerId], references: [id])
  shippingAddress   CustomerAddress? @relation(fields: [shippingAddressId], references: [id])
  showroom          Warehouse?       @relation(fields: [showroomId], references: [id])
  items             OrderItem[]
  payments          Payment[]
  shipments         Shipment[]
  returns           OrderReturn[]

  @@index([customerId, createdAt])
  @@map("orders")
}

model OrderItem {
  id         String         @id @default(uuid()) @db.Uuid
  orderId    String         @map("order_id") @db.Uuid
  variantId  String         @map("variant_id") @db.Uuid
  quantity   Int
  unitPrice  Decimal        @map("unit_price") @db.Decimal(12, 2)
  totalPrice Decimal        @map("total_price") @db.Decimal(12, 2)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz

  order      Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant    ProductVariant @relation(fields: [variantId], references: [id])

  @@map("order_items")
}

model Payment {
  id             String   @id @default(uuid()) @db.Uuid
  orderId        String   @map("order_id") @db.Uuid
  provider       String   @db.VarChar(50)
  transactionRef String   @map("transaction_ref") @db.VarChar(100)
  amount         Decimal  @db.Decimal(12, 2)
  status         String   @db.VarChar(30) // SUCCESS, FAILED, PENDING
  payload        Json?    @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  order          Order    @relation(fields: [orderId], references: [id])

  @@map("payments")
}

model Shipment {
  id             String    @id @default(uuid()) @db.Uuid
  orderId        String    @map("order_id") @db.Uuid
  trackingNumber String?   @map("tracking_number") @db.VarChar(100)
  carrier        String?   @db.VarChar(100)
  status         String    @db.VarChar(30)
  shippedAt      DateTime? @map("shipped_at") @db.Timestamptz
  deliveredAt    DateTime? @map("delivered_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  order          Order     @relation(fields: [orderId], references: [id])

  @@map("shipments")
}

model OrderReturn {
  id          String    @id @default(uuid()) @db.Uuid
  orderId     String    @map("order_id") @db.Uuid
  status      String    @db.VarChar(30) // RETURN_REQUESTED, RETURNED, REJECTED
  reason      String?   @db.VarChar(1000)
  requestedAt DateTime  @default(now()) @map("requested_at") @db.Timestamptz
  processedAt DateTime? @map("processed_at") @db.Timestamptz

  order       Order     @relation(fields: [orderId], references: [id])

  @@map("order_returns")
}

// -------------------------------------------------------------
// 9. Grand Couture Week & Events (MOD-EVT)
// -------------------------------------------------------------

model Event {
  id               String                @id @default(uuid()) @db.Uuid
  name             String                @db.VarChar(200)
  startsOn         DateTime              @map("starts_on") @db.Date
  venue            String                @db.VarChar(255)
  status           String                @default("draft") @db.VarChar(20) // draft, published
  registrationOpen Boolean               @default(true) @map("registration_open")
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  milestones       EventMilestone[]
  teamAssignments EventTeamAssignment[]
  guests           EventGuest[]
  invitations      EventInvitation[]
  registrations    EventRegistration[]
  tasks            EventTask[]
  looks            EventLook[]

  @@map("events")
}

model EventMilestone {
  id             String    @id @default(uuid()) @db.Uuid
  eventId        String    @map("event_id") @db.Uuid
  milestoneGroup String    @map("milestone_group") @db.VarChar(100)
  targetMonths   Int       @map("target_months")
  isDone         Boolean   @default(false) @map("is_done")
  completedAt    DateTime? @map("completed_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  event          Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_milestones")
}

model EventTeamAssignment {
  id         String   @id @default(uuid()) @db.Uuid
  eventId    String   @map("event_id") @db.Uuid
  team       String   @db.VarChar(100)
  employeeId String   @map("employee_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_team_assignments")
}

model EventGuest {
  id            String             @id @default(uuid()) @db.Uuid
  eventId       String             @map("event_id") @db.Uuid
  name          String             @db.VarChar(120)
  email         String             @db.VarChar(254)
  guestType     String             @map("guest_type") @db.VarChar(50) // vip, press, guest, staff-guest
  customerId    String?            @map("customer_id") @db.Uuid
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz

  event         Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  customer      Customer?          @relation(fields: [customerId], references: [id])
  invitations   EventInvitation[]
  registrations EventRegistration[]

  @@unique([eventId, email])
  @@map("event_guests")
}

model EventInvitation {
  id        String     @id @default(uuid()) @db.Uuid
  eventId   String     @map("event_id") @db.Uuid
  guestId   String     @map("guest_id") @db.Uuid
  sentAt    DateTime?  @map("sent_at") @db.Timestamptz
  status    String     @default("INVITED") @db.VarChar(30)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz

  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guest     EventGuest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@map("event_invitations")
}

model EventRegistration {
  id          String     @id @default(uuid()) @db.Uuid
  eventId     String     @map("event_id") @db.Uuid
  guestId     String     @map("guest_id") @db.Uuid
  reference   String     @unique @db.VarChar(128)
  status      String     @default("INVITED") @db.VarChar(30) // INVITED, REGISTERED, DECLINED, CHECKED_IN
  checkedInAt DateTime?  @map("checked_in_at") @db.Timestamptz
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz

  event       Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guest       EventGuest @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@index([reference])
  @@map("event_registrations")
}

model EventTask {
  id             String    @id @default(uuid()) @db.Uuid
  eventId        String    @map("event_id") @db.Uuid
  milestoneGroup String    @map("milestone_group") @db.VarChar(100)
  title          String    @db.VarChar(200)
  assigneeId     String?   @map("assignee_id") @db.Uuid
  status         String    @default("open") @db.VarChar(30) // open, in progress, done, cancelled
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  event          Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("event_tasks")
}

model EventLook {
  id            String      @id @default(uuid()) @db.Uuid
  eventId       String      @map("event_id") @db.Uuid
  fashionLinkId String      @map("fashion_link_id") @db.Uuid
  runwayOrder   Int?        @map("runway_order")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz

  event         Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  fashionLink   FashionLink @relation(fields: [fashionLinkId], references: [id], onDelete: Cascade)

  @@map("event_looks")
}

// -------------------------------------------------------------
// 10. Notifications & Audit Logs (MOD-NTF / MOD-AUD)
// -------------------------------------------------------------

model Notification {
  id          String    @id @default(uuid()) @db.Uuid
  recipientId String    @map("recipient_id") @db.Uuid
  channel     String    @db.VarChar(30) // in-app, email
  eventType   String    @map("event_type") @db.VarChar(50)
  template    String    @db.VarChar(100)
  payload     Json      @db.JsonB
  status      String    @default("pending") @db.VarChar(30) // pending, sent, failed
  retries     Int       @default(0)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  action    String   @db.VarChar(100)
  entity    String   @db.VarChar(100)
  entityId  String   @map("entity_id") @db.VarChar(100)
  details   Json?    @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("audit_logs")
}
